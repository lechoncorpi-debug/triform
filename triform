      <div class="media reveal-r reveal"><span class="num">02</span><img src="fut-4.jpeg" alt="Fútbol 7 en cancha reducida" loading="lazy" onerror="this.onerror=null;this.outerHTML='<div class=&quot;missing&quot;>Guarda esta foto como<br><b>fut-4.jpeg</b></div>'"></div>
